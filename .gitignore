# Manual source PDFs — large and re-downloadable via data/manuals/sources.toml.
# Only the converted .md, INDEX.md, and sources.toml are tracked.
data/manuals/**/*.pdf

# KB indexes — rebuildable artifact from `uv run kb/index.py`, not tracked.
kb/indexes/

# macOS
.DS_Store

# Research paper PDFs — re-downloadable from the url in each converted .md.
docs/research/**/*.pdf
